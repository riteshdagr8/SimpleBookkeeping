# SQLite database file.
# Prisma CLI resolves file: paths relative to the prisma/ directory.
# The app runtime also resolves relative to prisma/ so both agree.
DATABASE_URL="file:../data/app.db"

# NextAuth
# Generate a strong secret: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
NEXTAUTH_SECRET="change-me-please-replace-with-a-real-secret"
# Required. In production, change to https://your-domain.com and run behind
# a TLS-terminating reverse proxy (Caddy, nginx, Cloudflare). Session cookies
# carry the JWT — HTTP in production exposes the session token.
# Match the port used by start.cmd/start.sh (3100). For Docker, use http://localhost:3001.
NEXTAUTH_URL="http://localhost:3100"

# AES-256-GCM encryption key for all stored QuickBooks Desktop passwords (32 raw
# bytes, base64-encoded). Run `npm run crypto-init` to populate automatically.
# Anyone with filesystem access to this file and the .env file can decrypt every
# stored QB secret. Secure the server's filesystem accordingly.
APP_DATA_KEY=""

# Backup output directory (default: ./backups)
BACKUP_DIR=""
