# SQLite database file.
# Prisma CLI resolves file: paths relative to the prisma/ directory.
# The app runtime also resolves relative to prisma/ so both agree.
DATABASE_URL="file:../data/app.db"

# NextAuth
# Generate a strong secret: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
NEXTAUTH_SECRET="change-me-please-replace-with-a-real-secret"
# Derive the auth base URL from the incoming request (host + port) instead of
# hardcoding it, so the app works when reached via localhost, an IP, or a
# hostname. Only set NEXTAUTH_URL explicitly when the app is behind a
# TLS-terminating reverse proxy with a fixed public origin.
AUTH_TRUST_HOST=true
# NEXTAUTH_URL="https://your-domain.com"

# AES-256-GCM encryption key for all stored QuickBooks Desktop passwords (32 raw
# bytes, base64-encoded). Run `npm run crypto-init` to populate automatically.
# Anyone with filesystem access to this file and the .env file can decrypt every
# stored QB secret. Secure the server's filesystem accordingly.
APP_DATA_KEY=""

# Backup output directory (default: ./backups)
BACKUP_DIR=""

# Resend — password reset emails (https://resend.com)
# Get an API key from the Resend dashboard. Without it, password reset
# requests log a warning and no email is sent (dev-friendly degrade).
RESEND_API_KEY=""
# Optional. Sender address must be verified in Resend. Defaults to
# "SimpleBookkeeping <noreply@yourdomain.com>" which will fail until changed.
RESEND_FROM_EMAIL=""
