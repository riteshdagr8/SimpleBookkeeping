# SQLite database file (relative to project root)
DATABASE_URL="file:./data/app.db"

# NextAuth
# Generate a strong secret: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
NEXTAUTH_SECRET="change-me-please-replace-with-a-real-secret"
NEXTAUTH_URL="http://localhost:3000"

# 32 raw bytes, base64-encoded. Run `npm run crypto-init` to populate automatically.
APP_DATA_KEY=""

# Backup output directory (default: ./backups)
BACKUP_DIR=""
