generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  clients Client[]
  audits  AuditLog[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String   @unique
  name      String
  password  String
  role      String   @default("Staff") // "Admin" | "Staff"
  active    Boolean  @default(true)
  theme     String   @default("cloud-white")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audits AuditLog[]

  @@index([tenantId])
}

model Client {
  id                        String   @id @default(cuid())
  tenantId                  String
  fileNumber                String
  legalName                 String
  businessNumber            String?
  entityType                String?
  fiscalYearEnd             DateTime
  incorporationDate         DateTime?
  incorporationJurisdiction String?
  address                   String?
  phone                     String?
  email                     String?
  folderPath                String?
  qbPasswordEncrypted       String?
  hstApplicable             Boolean  @default(false)
  hstFrequency              String?
  payrollApplicable         Boolean  @default(false)
  payrollFrequency          String?
  remitterType              String?
  threeMonthEligible        Boolean  @default(false)
  onboardingStatus          String   @default("Pending")
  reviewComplete            Boolean  @default(false)
  notes                     String?
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folderChecklist   FolderChecklistItem[]
  historicalReviews HistoricalReview[]
  obligations       FilingObligation[]

  @@unique([tenantId, fileNumber])
  @@index([tenantId])
}

model FolderChecklistItem {
  id       String  @id @default(cuid())
  clientId String
  itemName String
  created  Boolean @default(false)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, itemName])
}

model HistoricalReview {
  id         String   @id @default(cuid())
  clientId   String
  fiscalYear Int
  filingType String
  status     String   @default("NA")
  notes      String?
  updatedAt  DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, fiscalYear, filingType])
}

model FilingObligation {
  id                 String    @id @default(cuid())
  clientId           String
  filingType         String
  periodStart        DateTime?
  periodEnd          DateTime?
  filingDueDate      DateTime?
  paymentDueDate     DateTime?
  status             String    @default("NotStarted")
  amount             Float?
  dateFiled          DateTime?
  confirmationNumber String?
  notes              String?
  autoGenerated      Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([filingDueDate])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String
  action    String
  entity    String?
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}
